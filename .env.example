# Copie para .env e preencha. O .env NUNCA deve ser commitado.
# Em produção (PaaS) cadastre estas variáveis no painel da plataforma.

# Ambiente: desenvolvimento (padrão) ou producao
APP_ENV=desenvolvimento
# Recarregamento automático e debugger do "python3 app.py" (nunca em produção)
FLASK_DEBUG=1

# Supabase: Project Settings > Database > Connect (Session pooler)
DB_HOST=aws-0-<regiao>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<ref-do-projeto>
DB_PASSWORD=<senha-do-banco>
PGSSLMODE=require
DB_CONNECT_TIMEOUT=10

# Pool de conexões, POR PROCESSO. Total no Supabase = WEB_CONCURRENCY x DB_POOL_MAX
# (+ worker de reciclagem). Em produção comece com WEB_CONCURRENCY=2 e DB_POOL_MAX=5.
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_TIMEOUT=10

# Fuso da janela de acesso por horário (o banco roda em UTC). Padrão: America/Sao_Paulo
TZ_EMPRESA=America/Sao_Paulo

# Obrigatória, mínimo 32 caracteres. A API não sobe sem ela.
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Use uma chave DIFERENTE em produção.
SECRET_KEY=<chave-longa-e-aleatoria>

# CORS: origens do front separadas por vírgula. Obrigatório em produção (https).
# Em desenvolvimento, vazio = http://localhost:3000 e http://localhost:5173
# CORS_ORIGINS=https://sandro-crm.netlify.app

# Produção (Gunicorn) — opcionais
# PORT=8000
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
# LOG_LEVEL=info
# SWAGGER_ATIVO=0
